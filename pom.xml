        <jackson.version>2.21.7</jackson.version>
        <vertx.version>4.5.35</vertx.version>
        <!-- Must match the Netty version Vert.x is built with (vertx-dependencies). -->
        <netty.version>4.1.139.Final</netty.version>
        <!-- Must match the SCRAM client vertx-pg-client is built against. -->
        <scram.version>3.3</scram.version>
        <micrometer.version>1.12.13</micrometer.version>
        <contextual-logging.version>1.2.1</contextual-logging.version>


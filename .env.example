# FHIR Validation Service — environment template.
# Copy to `.env` (git-ignored) and replace every `change-me` value.
# Full reference: specs/001-service-hardening/contracts/configuration.md

# --- Compose ---------------------------------------------------------------
COMPOSE_PROJECT_NAME=fhir
FV_TAG=latest
# Container memory; the JVM uses 75% as heap. Below 2g, warming 4 FHIR versions can run out of heap.
FV_MEMORY_LIMIT=2g

# --- Service ---------------------------------------------------------------
FV_PROFILE=prod
# Optional JSON file with settings (below environment variables in precedence); not for FV_LOG_FORMAT.
# FV_CONFIG_FILE=/etc/fhir-validator/config.json
# text | json
FV_LOG_FORMAT=text
FV_HTTP_PORT=8880
FV_HTTP_INSTANCES=
# Request body limit; IG uploads (/igs/upload) may be as large as FV_PACKAGE_MAX_COMPRESSED_MB + 1.
FV_HTTP_MAX_BODY_MB=20
FV_HTTP_REQUEST_TIMEOUT_MS=60000
FV_CORS_ALLOWED_ORIGINS=

FV_VALIDATION_WORKERS=
FV_VALIDATION_MAX_PENDING=
FV_VALIDATION_MAX_BUNDLE_ENTRIES=10000
FV_VALIDATION_TIMEOUT_MS=30000

FV_PACKAGE_WORKERS=2
# Administrative operations (upload, register, include-ig, register-profile) in progress per instance
FV_ADMIN_MAX_PENDING=4
FV_PACKAGE_CACHE_MAX_MB=256
# Hosts (registry https://<host>) or base URLs (scheme://host[:port])
FV_PACKAGE_SOURCES=packages.fhir.org,packages2.fhir.org
FV_PACKAGE_REGISTRY_ENABLED=true
# Dev profile only: allow http / private-network package sources
FV_PACKAGE_ALLOW_INSECURE_SOURCES=false
FV_PACKAGE_FETCH_TIMEOUT_MS=30000
FV_PACKAGE_MAX_COMPRESSED_MB=50
FV_PACKAGE_MAX_EXPANDED_MB=500
FV_PACKAGE_MAX_ENTRIES=20000
FV_PACKAGE_MAX_RATIO=100

FV_CONFIG_POLL_INTERVAL_MS=5000

FV_AUTH_ANONYMOUS_VALIDATE=true
# 32-128 characters of [A-Za-z0-9_-]. Without it, admin operations are refused.
FV_ADMIN_API_KEY=change-me-to-a-long-random-admin-key-0123456789
FV_AUTH_CACHE_TTL_MS=30000

FV_READINESS_DB_STALENESS_MS=10000
FV_SHUTDOWN_PRE_DRAIN_MS=5000
FV_SHUTDOWN_GRACE_MS=20000

# --- Database (FV_* names always win over the legacy PG_* aliases) ---------
FV_PG_HOST=postgres
FV_PG_PORT=5432
FV_PG_DATABASE=fhir_validator
FV_PG_USER=postgres
FV_PG_PASSWORD=change-me
FV_PG_POOL_SIZE=15
FV_PG_SSL_MODE=prefer
# Used by the compose postgres service itself (keep equal to FV_PG_PASSWORD)
PG_PASSWORD=change-me

# --- JVM (container only) ---------------------------------------------------
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError

# --- Optional: compose `admin` profile (pgAdmin) ----------------------------
PGADMIN_DEFAULT_EMAIL=admin@example.org
PGADMIN_DEFAULT_PASSWORD=change-me

{
  "profile": "prod",
  "http": {
    "port": 8880,
    "maxBodyMb": 20,
    "requestTimeoutMs": 60000,
    "cors": {
      "allowedOrigins": ""
    }
  },
  "validation": {
    "timeoutMs": 30000,
    "maxBundleEntries": 10000
  },
  "packages": {
    "workers": 2,
    "cacheMaxMb": 256,
    "sources": "packages.fhir.org,packages2.fhir.org",
    "registryEnabled": true,
    "fetchTimeoutMs": 30000,
    "maxCompressedMb": 50,
    "maxExpandedMb": 500,
    "maxEntries": 20000,
    "maxRatio": 100
  },
  "admin": {
    "maxPending": 4
  },
  "tx": {
    "registryRefreshMs": 21600000,
    "timeoutMs": 5000,
    "requestBudgetMs": 10000,
    "cacheSize": 5000,
    "cacheTtlMs": 600000,
    "maxConnectionsPerServer": 10
  },
  "sync": {
    "pollIntervalMs": 5000
  },
  "auth": {
    "cacheTtlMs": 30000
  },
  "usage": {
    "sink": "none",
    "queueSize": 10000,
    "batchSize": 500,
    "flushMs": 1000
  },
  "health": {
    "dbStalenessMs": 10000
  },
  "shutdown": {
    "preDrainMs": 5000,
    "graceMs": 20000
  },
  "systemOrg": {
  },
  "pg": {
    "host": "localhost",
    "port": 5432,
    "database": "fhir_validator",
    "user": "postgres",
    "poolSize": 15,
    "sslMode": "prefer"
  }
}

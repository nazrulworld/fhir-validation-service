<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" packages="io.reactiverse.contextual.logging">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <!-- %vcl{requestId} = correlation id of the request being served (empty outside requests) -->
            <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level [%vcl{requestId:-}] %logger{36} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
        <!-- Resource bodies may contain PHI: never log them above DEBUG. -->
        <Logger name="nzi.fhir.validator" level="info"/>
        <Logger name="org.flywaydb.core" level="info" />
    </Loggers>
</Configuration>
